#include <iostream>
#include <string>
using namespace std;

void insertionSortDescending(int arr[], int n, int &comparisons, int &shifts) {
    comparisons = 0;
    shifts = 0;
    
    for (int i = 1; i < n; i++) {
        int key = arr[i];
        int j = i - 1;
                while (j >= 0 && arr[j] < key) {
            comparisons++;
            arr[j + 1] = arr[j];
            shifts++;
            j--;
        }
        arr[j + 1] = key;
        if (j >= 0) comparisons++; // last failed comparison
    }
}

void insertionSortNames(string arr[], int n, int &comparisons, int &shifts) {
    comparisons = 0;
    shifts = 0;
    
    for (int i = 1; i < n; i++) {
        string key = arr[i];
        int j = i - 1;
        
        while (j >= 0 && arr[j] > key) {
            comparisons++;
            arr[j + 1] = arr[j];
            shifts++;
            j--;
        }
        arr[j + 1] = key;
        if (j >= 0) comparisons++;
    }
}

void insertionSortAscending(int arr[], int n, int &comparisons, int &shifts) {
    comparisons = 0;
    shifts = 0;
    
    for (int i = 1; i < n; i++) {
        int key = arr[i];
        int j = i - 1;
        
        while (j >= 0 && arr[j] > key) {
            comparisons++;
            arr[j + 1] = arr[j];
            shifts++;
            j--;
        }
        arr[j + 1] = key;
        if (j >= 0) comparisons++;
    }
}

int main() {

    int choice;
    cout << "===== INSERTION SORT - CHALLENGE ACTIVITIES =====\n";
    cout << "1. Sort numbers in DESCENDING order\n";
    cout << "2. Sort student names alphabetically\n";
    cout << "3. Sort numbers (ascending) + count comparisons & shifts\n";
    cout << "Enter choice: ";
    cin >> choice;
    
    if (choice == 1) {
        int n;
        cout << "Enter number of elements: ";
        cin >> n;
        int arr[n];
        cout << "Enter elements:\n";
        for (int i = 0; i < n; i++)
            cin >> arr[i];
        
        int comparisons, shifts;
        insertionSortDescending(arr, n, comparisons, shifts);
        
        cout << "Sorted (Descending): ";
        for (int i = 0; i < n; i++)
            cout << arr[i] << " ";
        cout << "\nComparisons: " << comparisons << "\nShifts: " << shifts << endl;
    }
    else if (choice == 2) {
        int n;
        cout << "Enter number of students: ";
        cin >> n;
        cin.ignore();
        string names[n];
        cout << "Enter student names:\n";
        for (int i = 0; i < n; i++)
            getline(cin, names[i]);
        
        int comparisons, shifts;
        insertionSortNames(names, n, comparisons, shifts);
        
        cout << "Sorted names: ";
        for (int i = 0; i < n; i++)
            cout << names[i] << " ";
        cout << "\nComparisons: " << comparisons << "\nShifts: " << shifts << endl;
    }
    else if (choice == 3) {
        int n;
        cout << "Enter number of elements: ";
        cin >> n;
        int arr[n];
        cout << "Enter elements:\n";
        for (int i = 0; i < n; i++)
            cin >> arr[i];
        
        int comparisons, shifts;
        insertionSortAscending(arr, n, comparisons, shifts);
        
        cout << "Sorted (Ascending): ";
        for (int i = 0; i < n; i++)
            cout << arr[i] << " ";
        cout << "\nComparisons: " << comparisons << "\nShifts: " << shifts << endl;
    }
    else {
        cout << "Invalid choice.\n";
    }
    
    return 0;
}

